# Base URL used for canonical links, sitemap and metadata
NEXT_PUBLIC_SITE_URL=https://www.manojtoursandtravels.in

# ---------------------------------------------------------------------------
# Admin panel — REQUIRED for /admin to work at all. Supabase is the only
# backend used: Postgres (enquiries, pricing/business-info/image overrides),
# Storage (uploaded fleet/destination photos) and Auth (admin login) all
# come from the same project.
# ---------------------------------------------------------------------------

# Project URL and public anon key — find both in Supabase dashboard →
# Project Settings → API. Safe to expose to the browser (NEXT_PUBLIC_), but
# Row Level Security is what actually limits what the anon key can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — Project Settings → API → "service_role secret". Bypasses
# Row Level Security entirely. Server-only: never prefix with NEXT_PUBLIC_,
# never import it from a Client Component, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: restricts admin access to exactly this one Supabase Auth account
# (by email), in case more than one user ever exists in this project. Leave
# blank to allow any authenticated user in the project to sign in as admin.
ADMIN_EMAIL=

# Optional: enable when an enquiry email/CRM integration is connected
# ENQUIRY_EMAIL_TO=manojtaxitravels@gmail.com
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
